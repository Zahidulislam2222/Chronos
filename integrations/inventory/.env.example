CHRONOS_INVENTORY_TOKEN=replace-with-generated-private-token
CHRONOS_INVENTORY_DATABASE=state/inventory.sqlite3
CHRONOS_INVENTORY_BIND_HOST=127.0.0.1
CHRONOS_INVENTORY_PORT=5680
CHRONOS_INVENTORY_REQUEST_TIMEOUT=30
CHRONOS_INVENTORY_BODY_LIMIT=1048576
CHRONOS_INVENTORY_BATCH_LIMIT=100
CHRONOS_INVENTORY_GALLERY_LIMIT=30
CHRONOS_INVENTORY_CURRENCY=BDT
CHRONOS_INVENTORY_SOURCE_NAMESPACE=chronos-woocommerce
CHRONOS_INVENTORY_AVAILABLE_STATUSES=available,in_stock
CHRONOS_INVENTORY_IMAGE_HOSTS=
CHRONOS_INVENTORY_WOO_ORIGIN=
CHRONOS_INVENTORY_SOURCE_API_PATH=/wp-json/wc/store/v1/products
CHRONOS_INVENTORY_SOURCE_PAGE_SIZE=100
CHRONOS_INVENTORY_SOURCE_PAGE_LIMIT=10
CHRONOS_INVENTORY_SOURCE_EXCLUDED_IDS=
