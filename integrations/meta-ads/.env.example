# Offline never contacts Meta. Live starts read-only.
CHRONOS_ADS_MODE=offline
CHRONOS_ADS_META_TOKEN=
CHRONOS_ADS_ACCOUNT_ID=
CHRONOS_ADS_META_ORIGIN=https://graph.facebook.com
# Required for live; select a version supported by YOUR Meta app.
CHRONOS_ADS_API_VERSION=
CHRONOS_ADS_WRITE_ENABLED=false
CHRONOS_ADS_TIMEOUT_SECONDS=20
CHRONOS_ADS_PAGE_SIZE=50
CHRONOS_ADS_MAX_PAGES=10
CHRONOS_ADS_MAX_REPORT_DAYS=90
CHRONOS_ADS_PROPOSAL_TTL_SECONDS=3600
CHRONOS_ADS_DATABASE_TIMEOUT_SECONDS=10
# Relative paths resolve from the directory containing your --env-file.
CHRONOS_ADS_STATE_DB=../../memory/claude-meta-ads/state.sqlite3
# Blank uses validated package content. Override with your maintained JSON file.
CHRONOS_ADS_PROFILE_PATH=
CHRONOS_ADS_OFFLINE_DATA_PATH=
