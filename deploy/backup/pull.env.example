# $HOME/chronos-backup/pull.env on the off-host copy server (0600). No secrets:
# the SSH private key stays in its own file and can only run the backup command.
BACKUP_HOST=backend.example
BACKUP_USER=chronos-backup
SSH_KEY=$HOME/.ssh/chronos-backup-pull
KNOWN_HOSTS=$HOME/chronos-backup/known_hosts
RETENTION_DAYS=14
PULL_TIMEOUT=2h
