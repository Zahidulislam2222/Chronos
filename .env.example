# ── Frontend Environment Variables (public — baked into the browser bundle) ──
# NEVER put real secrets here; anything VITE_* is visible in the shipped JS.

# GraphQL endpoint for the WordPress backend
VITE_API_URL="https://backend.example/graphql"

# REST API base for the WordPress backend (checkout, contact, health)
VITE_WP_API_URL="https://backend.example"

# Public canonical site URL (used for SEO canonical / Open Graph tags)
VITE_SITE_URL="https://chronos.example"

# Local design preview blocks external mutations. Use connected only for a verified store.
VITE_STOREFRONT_MODE="preview"

# Enable only after canonical URL and rendered HTML verification.
VITE_SEARCH_INDEXABLE="false"

# Connected content request timeout, pagination and foreground refresh.
VITE_REQUEST_TIMEOUT_MS="30000"
VITE_CONTENT_PAGE_SIZE="50"
VITE_CONTENT_REFRESH_MS="30000"

# ── Maintenance scripts (not read by Vite; export in the shell that runs them) ──
# scripts/gcp-setup.sh — backend hostname for nginx/TLS/WP_HOME
# CHRONOS_BACKEND_DOMAIN="backend.example"
# scripts/prepare-db.py — URL rewrite when moving a database dump to a new host
# CHRONOS_OLD_URLS="https://old-backend.example,http://localhost:8888"
# CHRONOS_NEW_URL="https://backend.example"
