# ── Frontend Environment Variables (public — baked into the browser bundle) ──
# NEVER put real secrets here; anything VITE_* is visible in the shipped JS.

# GraphQL endpoint for the WordPress backend
VITE_API_URL="https://backend.example/graphql"

# REST API base for the WordPress backend (checkout, contact, health)
VITE_WP_API_URL="https://backend.example"

# Public canonical site URL (used for SEO canonical / Open Graph tags)
VITE_SITE_URL="https://chronos.example"

# Offline mode blocks external mutations. Use connected only for a verified store.
VITE_STOREFRONT_MODE="preview"

# Enable only after canonical URL and rendered HTML verification.
VITE_SEARCH_INDEXABLE="false"

# Connected content request timeout, pagination and foreground refresh.
VITE_REQUEST_TIMEOUT_MS="30000"
VITE_CONTENT_PAGE_SIZE="50"
VITE_CONTENT_REFRESH_MS="30000"

# ── Maintenance scripts (not read by Vite; export in the shell that runs them) ──
# scripts/gcp-setup.sh — backend hostname for nginx/TLS/WP_HOME
# CHRONOS_BACKEND_DOMAIN="backend.example"
# scripts/prepare-db.py — URL rewrite when moving a database dump to a new host
# CHRONOS_OLD_URLS="https://old-backend.example,http://localhost:8888"
# CHRONOS_NEW_URL="https://backend.example"

# AI guide service. Local inference uses only localhost Ollama.
# Defaults and request/concurrency limits are owned by config/assistant.json.
# Export overrides in the service process environment (not VITE_ browser settings).
# CHRONOS_ASSISTANT_PORT="18784"
# CHRONOS_ASSISTANT_OLLAMA_ORIGIN="http://127.0.0.1:11434"
# CHRONOS_ASSISTANT_MODEL="qwen3:1.7b"
# CHRONOS_ASSISTANT_ALLOWED_ORIGINS="http://127.0.0.1:8080,http://127.0.0.1:4173,http://127.0.0.1:4175"
# Runtime can disable the maintained guide flag.
# CHRONOS_ASSISTANT_ENABLED="false"

# Server-only optional provider configuration (never prefix these with VITE_).
# Set either the secret file or the direct environment secret, not both.
# Keep paid fallback disabled for local setup. Copy this section to .env.assistant.local.
CHRONOS_ASSISTANT_OPENROUTER_ENABLED="false"
# CHRONOS_ASSISTANT_OPENROUTER_KEY_FILE="/run/secrets/chronos-openrouter"
# CHRONOS_ASSISTANT_OPENROUTER_KEY=""
# CHRONOS_ASSISTANT_BUDGET_FILE="/var/lib/chronos-guide/budget.json"

# Only enable behind the trusted proxy that OVERWRITES X-Chronos-Client-IP.
# CHRONOS_ASSISTANT_TRUST_PROXY_HEADERS="false"
